[Unit]
Description=Pepper Clinical Infinity V6 — FastAPI
After=network.target

[Service]
Type=notify
User=pepper
Group=pepper
WorkingDirectory=/home/pepper/pepper_server
Environment="PATH=/home/pepper/pepper_server/venv/bin"
ExecStart=/home/pepper/pepper_server/venv/bin/gunicorn app.main:app -c gunicorn_conf.py
Restart=always
RestartSec=5
LimitNOFILE=65536
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pepper/pepper_server/data /home/pepper/pepper_server/logs
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
