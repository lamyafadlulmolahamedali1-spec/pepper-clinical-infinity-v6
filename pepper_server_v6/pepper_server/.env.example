# ── Pepper Clinical V6 — Environment Configuration ──
# Copy to .env and fill in. NEVER commit .env to git.

ENV=production
DEBUG=false

# Security — generate strong random values:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_48_CHARS
JWT_SECRET=CHANGE_ME_RANDOM_48_CHARS
ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_CHARS

# Database (SQLite default; for Postgres use):
# DATABASE_URL=postgresql://user:pass@localhost:5432/pepper
DATABASE_URL=sqlite:///./data/pepper.db

# CORS — restrict in production:
ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=4
